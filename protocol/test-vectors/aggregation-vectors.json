      ],
      "expected": {
        "score": 0.571,
        "contributing_receipts": 2,
        "contributing_issuers": 1,
        "_explanation": "recent: decay=1.0, weight=1.0 (positive). old (age=120s=1 half-life): decay=0.5, score=0.0<0.5 \u2192 weight=0.5*1.5=0.75. issuer_score(A)=(1.0*1.0+0.0*0.75)/(1.0+0.75)=1.0/1.75=0.5714"
      }
